<!doctype html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="resources/css/style.css">
    <title>Telesonic</title>
  </head>
  <body class="text-center">
    <nav class="navbar">
      <div class="navbar-container">
        <a href="index" class="navbar-brand" id="telesonic">
          <img src="/resources/images/telesonic.png" alt="Telesonic Logo" id="telesonic-logo">
        </a>
        <div class="navbar-links">
          <% if (login) { %>
            <span class="navbar-user">Usuario: <strong><%= name %></strong></span>
            <a href="almacen" class="navbar-link">Almacen</a>
            <a href="logout" class="navbar-link">Cerrar sesion</a>
          <% } else { %>
            <a href="register" class="navbar-link">Registrarse</a>
          <% } %>
            
        </div>
      </div>
    </nav>
    <div class="contenedor">
      <h1>Página de Inicio</h1>
      <% if (login) { %>
        <h1>Usuario conectado: <strong><%= name %></strong></h1>
        <a href="logout" class="a-logout">Cerrar sesion</a>
      <%} else { %>
        <h1>Bienvenido, visitante</h1>
        <a href="login" class="a-login">Iniciar sesion</a>
      <% } %>
    </div>
  </body>
</html>
